# Godot-specific ignores
.godot/
*.translation
*.signature

# Android export builds
*.apk
*.apks
*.aab

# OS generated files
.DS_Store
Thumbs.db

# Android keystore (CRITICAL: never commit your signing key!)
android/keystore/*.keystore
android/keystore/*.jks
android/keystore/*.keystore.*

# raw CC0 downloads; the game ships the processed web/assets/audio (see its CREDITS.md)
web/assets-src/

# Android build output and the local debug signing key
web/dist/
web/android/debug.keystore
__pycache__/
node_modules/
web/tools/voices/.refs/
web/tools/voices/.retake.txt
unity/HorrorPlay/Assets/ThirdPartyRaw/
unity/HorrorPlay/Assets/ThirdPartyRaw.meta

# QA/generated candidates (P2-B photo work); never commit temp PNGs
web/art_review/room_photo_map/2d_integration/work/
